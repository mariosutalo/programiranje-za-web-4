<!DOCTYPE html>
<% locals.pageStyles.push('/styles/header.css') %>
    <% locals.pageStyles.push('/styles/checkout.css') %>
        <%- include('./partials/head.ejs') %>

            <body>
                <%- include('./partials/header.ejs') %>
                    <div class="container-div">
                        <h2>Shipping Information</h2>
                        <form action="/checkout" method="post">
                            <div class="form-container-div">
                                <div>
                                    <label for="full-name">Full Name</label>
                                    <input class="form-value-input" type="text" name="fullname" id="full-name" required>
                                </div>
                                <div>
                                    <label for="street">Street</label>
                                    <input class="form-value-input" type="text" name="street" id="street" required>
                                </div>
                                <div>
                                    <Label for="zip-code">ZIP Code</Label>
                                    <input class="form-value-input" type="text" name="zipcode" id="zip-code" required>
                                </div>
                                <div>
                                    <label for="city">City</label>
                                    <input class="form-value-input" type="text" name="city" id="city" required>
                                </div>
                                <div>
                                    <label for="phone">Phone</label>
                                    <input class="form-value-input" type="text" name="phone" id="phone" required>
                                </div>
                                <button class="submit-btn" type="submit">Payment</button>
                            </div>

                        </form>
                    </div>
                    <%- include('./partials/footer.ejs') %>
            </body>