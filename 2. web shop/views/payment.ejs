<!DOCTYPE html>
<% locals.pageStyles.push('/styles/payment.css') %>
    <% locals.pageStyles.push('/styles/header.css') %>
        <%- include('./partials/head.ejs') %>

            <body>
                <%- include('./partials/header.ejs') %>
                    <main>
                        <section>
                            <div class="container-div">
                                <h1>Payment details</h1>
                                <form action="/payment" class="payment-form" method="post">
                                    <h2>Select payment method</h2>
                                    <div class="payment-method-div">
                                        <label for="cashRadio" class="payment-label">
                                            <div class="pay-options-div">
                                                <input type="radio" name="paymentMethod" value="cash" id="cashRadio"
                                                    onchange="togglePaymentType(this)">
                                                <div>
                                                    <h3>Pay on Delivery</h3>
                                                    <p>Cash or Card upon receipt</p>
                                                </div>
                                            </div>
                                            <img class="payment-type-img" src="/assets/truck.png" alt="">
                                        </label>
                                        <label for="cardRadio" class="payment-label">
                                            <div class="pay-options-div">
                                                <input type="radio" name="paymentMethod" value="card" id="cardRadio"
                                                    onchange="togglePaymentType(this)">
                                                <div>
                                                    <h3>Card Payment</h3>
                                                    <p>Secure online transaction</p>
                                                </div>
                                            </div>
                                            <img class="payment-type-img" src="/assets/credit card icon.webp" alt="">
                                        </label>
                                    </div>
                                    <fieldset id="card-payment-fs">
                                        <div class="form-input-label-div">
                                            <label for="card-number" class="form-input-label">Card Number</label>
                                            <input type="number" id="card-number" name="cardNumber"
                                                class="form-value-input">
                                        </div>
                                        <div class="grouped-input-div">
                                            <div class="form-input-label-div">
                                                <label for="card-expiry" class="form-input-label">Expiry Date</label>
                                                <input type="number" id="card-expiry" name="cardExpiry"
                                                    class="form-value-input">
                                            </div>
                                            <div class="form-input-label-div">
                                                <label for="card-cvv" class="form-input-label">CVV</label>
                                                <input type="number" id="card-cvv" name="cardCvv"
                                                    class="form-value-input">
                                            </div>
                                        </div>

                                    </fieldset>
                                    <button class="confirm-payment-btn">Confirm Payment</button>
                                </form>
                            </div>
                        </section>
                    </main>
                    <%- include('./partials/footer.ejs') %>
                        <script>
                            function togglePaymentType(radioSource) {
                                const cardPaymentFieldSet = document.getElementById('card-payment-fs')
                                if (!cardPaymentFieldSet) {
                                    return
                                }
                                if (radioSource.id === 'cashRadio') {
                                    //cardPaymentDiv.innerHTML = ""
                                    cardPaymentFieldSet.style.display = 'none'
                                    cardPaymentFieldSet.disabled = true
                                } else if (radioSource.id === 'cardRadio') {
                                    // const content = `
                                    // <label>Card number</label>
                                    // <input type="number"></input>
                                    // `
                                    // cardPaymentDiv.innerHTML = content
                                    cardPaymentFieldSet.style.display = 'flex'
                                    cardPaymentFieldSet.disabled = false
                                }
                            }
                        </script>
            </body>